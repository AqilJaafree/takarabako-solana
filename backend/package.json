{
  "name": "@takarabako/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Takarabako backend/orchestrator — PRD §7.3. Treasury signer, deposit/verify/withdraw API, kiosk-facing endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "services": "node scripts/dev-services.mjs",
    "mb:setup": "tsx --env-file=.env scripts/multibaas-setup.ts",
    "ens:setup": "tsx --env-file=.env scripts/ens-setup.ts",
    "ens:migrate": "tsx --env-file=.env scripts/ens-migrate.ts",
    "ens:kiosk": "tsx --env-file=.env scripts/ens-kiosk.ts",
    "sol:setup": "tsx --env-file=.env scripts/sol-setup.ts",
    "sol:smoke": "tsx --env-file=.env scripts/sol-smoke.ts",
    "sol:flow": "tsx --env-file=.env scripts/sol-flow.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "^0.3.4",
    "@1inch/swap-vm-sdk": "^0.4.4",
    "@anthropic-ai/sdk": "^0.125.0",
    "@curvegrid/multibaas-sdk": "^1.1.1",
    "@meteora-ag/dlmm": "^1.9.14",
    "@privy-io/node": "^0.34.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "bullmq": "^6.3.9",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.30.0",
    "viem": "^2.56.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
